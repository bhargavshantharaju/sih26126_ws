<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sih26126_showcase_valley">
    <physics name="showcase_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene>
      <ambient>0.48 0.52 0.58 1</ambient>
      <background>0.63 0.76 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 24 0 0 0</pose>
      <diffuse>0.94 0.88 0.75 1</diffuse>
      <specular>0.28 0.27 0.24 1</specular>
      <direction>-0.38 0.25 -0.89</direction>
    </light>

    <!-- Local grayscale heightmap: low valley floor with smooth mountain shoulders. -->
    <model name="valley_terrain">
      <static>true</static>
      <link name="terrain">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>worlds/showcase_heightmap.png</uri>
              <size>80 60 5</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <mesh><uri>worlds/showcase_terrain.stl</uri></mesh>
          </geometry>
          <material>
            <ambient>0.36 0.31 0.22 1</ambient>
            <diffuse>0.47 0.39 0.27 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The basin is recessed in the heightmap. Water is a visual-only overlay. -->
    <model name="lake_visual">
      <static>true</static>
      <pose>12 -18 0.24 0 0 0</pose>
      <link name="water_surface">
        <visual name="lake">
          <geometry><ellipsoid><radii>8.1 4.9 0.10</radii></ellipsoid></geometry>
          <material>
            <ambient>0.035 0.22 0.31 1</ambient>
            <diffuse>0.055 0.38 0.52 1</diffuse>
            <specular>0.55 0.68 0.78 1</specular>
            <emissive>0.015 0.06 0.08 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>models/sih_ugv/sih_ugv.sdf</uri>
      <name>sih_ugv</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Staggered conifers leave a central four-meter travel corridor. -->
    <model name="pine_01"><static>true</static><pose>4 3.4 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 1.05 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>2.1</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 1.05 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>2.1</length></cylinder></geometry><material><diffuse>0.31 0.19 0.10 1</diffuse></material></visual>
      <visual name="crown_lower"><pose>0 0 2.45 0 0 0</pose><geometry><cone><radius>1.15</radius><length>2.4</length></cone></geometry><material><diffuse>0.11 0.31 0.15 1</diffuse></material></visual>
      <visual name="crown_upper"><pose>0 0 3.35 0 0 0</pose><geometry><cone><radius>0.82</radius><length>2.1</length></cone></geometry><material><diffuse>0.16 0.39 0.19 1</diffuse></material></visual>
    </link></model>
    <model name="pine_02"><static>true</static><pose>7 -3.7 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>1.8</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>1.8</length></cylinder></geometry><material><diffuse>0.30 0.18 0.09 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.4 0 0 0</pose><geometry><cone><radius>1.1</radius><length>2.7</length></cone></geometry><material><diffuse>0.10 0.30 0.14 1</diffuse></material></visual>
    </link></model>
    <model name="pine_03"><static>true</static><pose>11 4.2 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.23</radius><length>2.4</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.23</radius><length>2.4</length></cylinder></geometry><material><diffuse>0.32 0.20 0.11 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.9 0 0 0</pose><geometry><cone><radius>1.35</radius><length>3.1</length></cone></geometry><material><diffuse>0.12 0.33 0.15 1</diffuse></material></visual>
    </link></model>
    <model name="pine_04"><static>true</static><pose>14 -4.0 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.9</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.9</length></cylinder></geometry><material><diffuse>0.31 0.19 0.10 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.5 0 0 0</pose><geometry><cone><radius>1.18</radius><length>2.8</length></cone></geometry><material><diffuse>0.10 0.29 0.14 1</diffuse></material></visual>
    </link></model>
    <model name="pine_05"><static>true</static><pose>18 3.3 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 1.0 0 0 0</pose><geometry><cylinder><radius>0.19</radius><length>2.0</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 1.0 0 0 0</pose><geometry><cylinder><radius>0.19</radius><length>2.0</length></cylinder></geometry><material><diffuse>0.30 0.18 0.09 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.7 0 0 0</pose><geometry><cone><radius>1.3</radius><length>3.0</length></cone></geometry><material><diffuse>0.12 0.34 0.16 1</diffuse></material></visual>
    </link></model>
    <model name="pine_06"><static>true</static><pose>22 -3.5 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 1.05 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>2.1</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 1.05 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>2.1</length></cylinder></geometry><material><diffuse>0.31 0.18 0.09 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.7 0 0 0</pose><geometry><cone><radius>1.35</radius><length>3.0</length></cone></geometry><material><diffuse>0.10 0.30 0.13 1</diffuse></material></visual>
    </link></model>
    <model name="pine_07"><static>true</static><pose>27 4.1 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.23</radius><length>2.4</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.23</radius><length>2.4</length></cylinder></geometry><material><diffuse>0.31 0.19 0.10 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.9 0 0 0</pose><geometry><cone><radius>1.5</radius><length>3.2</length></cone></geometry><material><diffuse>0.11 0.32 0.15 1</diffuse></material></visual>
    </link></model>
    <model name="pine_08"><static>true</static><pose>31 -4.0 0 0 0 0</pose><link name="trunk">
      <collision name="trunk_collision"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.9</length></cylinder></geometry></collision>
      <visual name="trunk_visual"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.9</length></cylinder></geometry><material><diffuse>0.31 0.19 0.10 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 2.55 0 0 0</pose><geometry><cone><radius>1.2</radius><length>2.8</length></cone></geometry><material><diffuse>0.11 0.32 0.15 1</diffuse></material></visual>
    </link></model>

    <!-- Rounded rocks cluster beside the route, with one detectable corridor obstacle. -->
    <model name="granite_boulder_01"><static>true</static><pose>5.2 1.65 0.40 0.1 0.2 0</pose><link name="stone">
      <collision name="stone_collision"><geometry><sphere><radius>0.48</radius></sphere></geometry></collision>
      <visual name="stone_visual"><geometry><sphere><radius>0.48</radius></sphere></geometry><material><diffuse>0.34 0.36 0.37 1</diffuse></material></visual>
    </link></model>
    <model name="granite_boulder_02"><static>true</static><pose>8.0 -2.5 0.30 0.2 0.3 0.2</pose><link name="stone">
      <collision name="stone_collision"><geometry><sphere><radius>0.34</radius></sphere></geometry></collision>
      <visual name="stone_visual"><geometry><sphere><radius>0.34</radius></sphere></geometry><material><diffuse>0.40 0.39 0.36 1</diffuse></material></visual>
    </link></model>
    <model name="granite_boulder_03"><static>true</static><pose>17 1.9 0.42 0.1 0.4 0.2</pose><link name="stone">
      <collision name="stone_collision"><geometry><sphere><radius>0.50</radius></sphere></geometry></collision>
      <visual name="stone_visual"><geometry><sphere><radius>0.50</radius></sphere></geometry><material><diffuse>0.31 0.33 0.35 1</diffuse></material></visual>
    </link></model>

    <!-- Fallen timber partially intrudes into the path but leaves room to steer around it. -->
    <model name="fallen_log"><static>true</static><pose>11.5 1.35 0.27 1.570796 0 0</pose><link name="log">
      <collision name="log_collision"><geometry><cylinder><radius>0.25</radius><length>2.8</length></cylinder></geometry></collision>
      <visual name="bark"><geometry><cylinder><radius>0.25</radius><length>2.8</length></cylinder></geometry><material><diffuse>0.28 0.16 0.08 1</diffuse></material></visual>
      <visual name="cut_end"><pose>0 0 1.4 0 0 0</pose><geometry><cylinder><radius>0.23</radius><length>0.02</length></cylinder></geometry><material><diffuse>0.62 0.43 0.24 1</diffuse></material></visual>
    </link></model>

    <!-- Scattered out-of-corridor boulders and saplings add depth without closing the route. -->
    <model name="rock_cluster_a"><static>true</static><pose>3.5 6.0 0.3 0 0 0</pose><link name="rocks">
      <collision name="c1"><pose>0 0 0.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
      <visual name="v1"><pose>0 0 0.2 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry><material><diffuse>0.38 0.39 0.37 1</diffuse></material></visual>
      <visual name="v2"><pose>0.5 0.2 0.15 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry><material><diffuse>0.32 0.35 0.36 1</diffuse></material></visual>
    </link></model>
    <model name="pine_09"><static>true</static><pose>-5 5.3 0 0 0 0</pose><link name="tree">
      <collision name="trunk"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>1.7</length></cylinder></geometry></collision>
      <visual name="bark"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>1.7</length></cylinder></geometry><material><diffuse>0.31 0.19 0.10 1</diffuse></material></visual>
      <visual name="leaves"><pose>0 0 2.3 0 0 0</pose><geometry><cone><radius>1.05</radius><length>2.6</length></cone></geometry><material><diffuse>0.11 0.32 0.15 1</diffuse></material></visual>
    </link></model>
    <model name="pine_10"><static>true</static><pose>-2 -5.6 0 0 0 0</pose><link name="tree">
      <collision name="trunk"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.9</length></cylinder></geometry></collision>
      <visual name="bark"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.9</length></cylinder></geometry><material><diffuse>0.31 0.19 0.10 1</diffuse></material></visual>
      <visual name="leaves"><pose>0 0 2.5 0 0 0</pose><geometry><cone><radius>1.2</radius><length>2.8</length></cone></geometry><material><diffuse>0.10 0.30 0.14 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
