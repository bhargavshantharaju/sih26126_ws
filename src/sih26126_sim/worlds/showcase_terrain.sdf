    <!-- Valley terrain with elevation variation -->
    <model name="valley_terrain">
      <static>true</static>
      <link name="terrain">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>worlds/showcase_heightmap.png</uri>
              <size>80 60 5</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <mesh><uri>worlds/showcase_terrain.stl</uri></mesh>
          </geometry>
          <material>
            <ambient>0.38 0.33 0.24 1</ambient>
            <diffuse>0.50 0.42 0.29 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- LARGE LAKE/RESERVOIR with collision wall -->
    <model name="lake_reservoir">
      <static>true</static>
      <pose>12 -18 0.26 0 0 0</pose>
      <link name="water">
        <visual name="water_surface">
          <geometry><ellipsoid><radii>11.0 6.5 0.12</radii></ellipsoid></geometry>
          <material>
            <ambient>0.042 0.24 0.35 1</ambient>
            <diffuse>0.065 0.42 0.58 1</diffuse>
            <specular>0.60 0.72 0.82 1</specular>
            <emissive>0.018 0.08 0.10 1</emissive>
          </material>
        </visual>
        <!-- Collision wall prevents driving into lake -->
        <collision name="lake_wall">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><cylinder><radius>10.8</radius><length>1.3</length></cylinder></geometry>
        </collision>
      </link>
    </model>

