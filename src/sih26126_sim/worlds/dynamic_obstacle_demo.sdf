<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="dynamic_obstacle_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.91 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.45 0.32 -1</direction>
    </light>
    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
        <material><ambient>0.30 0.40 0.25 1</ambient><diffuse>0.36 0.46 0.30 1</diffuse></material>
      </visual>
    </link></model>
    <include><uri>models/sih_ugv/sih_ugv.sdf</uri><name>sih_ugv</name><pose>0 0 0 0 0 0</pose></include>
    <!-- Physical dynamic test target. Its only controller is the simulation pose service. -->
    <model name="dynamic_obstacle">
      <static>false</static><pose>3.2 -2.0 0.55 0 0 0</pose>
      <link name="body">
        <kinematic>true</kinematic><gravity>false</gravity>
        <collision name="collision"><geometry><box><size>0.65 0.65 1.10</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 0.65 1.10</size></box></geometry>
          <material><ambient>0.9 0.12 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
