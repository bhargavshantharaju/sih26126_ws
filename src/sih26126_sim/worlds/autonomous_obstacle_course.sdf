<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="autonomous_obstacle_course">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene>
      <ambient>0.48 0.52 0.44 1</ambient>
      <background>0.72 0.82 0.91 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        <material><ambient>0.27 0.38 0.19 1</ambient><diffuse>0.34 0.46 0.23 1</diffuse></material>
      </visual>
    </link></model>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose>
      <diffuse>0.88 0.84 0.73 1</diffuse><direction>-0.45 0.32 -1</direction>
    </light>
    <!-- Robot starts at the origin; the mapper receives no preloaded map. -->
    <include><uri>models/sih_ugv/sih_ugv.sdf</uri><name>sih_ugv</name><pose>0 0 0 0 0 0</pose></include>

    <!-- Boundary walls bound the repeatable exploration arena. -->
    <model name="boundary_north"><static>true</static><pose>0 6.6 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>13.2 0.25 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>13.2 0.25 1.6</size></box></geometry><material><ambient>0.28 0.29 0.27 1</ambient><diffuse>0.36 0.37 0.34 1</diffuse></material></visual></link></model>
    <model name="boundary_south"><static>true</static><pose>0 -6.6 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>13.2 0.25 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>13.2 0.25 1.6</size></box></geometry><material><ambient>0.28 0.29 0.27 1</ambient><diffuse>0.36 0.37 0.34 1</diffuse></material></visual></link></model>
    <model name="boundary_west"><static>true</static><pose>-6.6 0 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 13.2 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 13.2 1.6</size></box></geometry><material><ambient>0.28 0.29 0.27 1</ambient><diffuse>0.36 0.37 0.34 1</diffuse></material></visual></link></model>
    <model name="boundary_east"><static>true</static><pose>6.6 0 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 13.2 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 13.2 1.6</size></box></geometry><material><ambient>0.28 0.29 0.27 1</ambient><diffuse>0.36 0.37 0.34 1</diffuse></material></visual></link></model>

    <!-- First substantial obstacle: a barrier with a narrow off-axis passage. -->
    <model name="gate_south"><static>true</static><pose>2.6 -2.725 0.65 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.36 7.75 1.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.36 7.75 1.3</size></box></geometry><material><ambient>0.30 0.32 0.31 1</ambient><diffuse>0.38 0.40 0.39 1</diffuse></material></visual></link></model>
    <model name="gate_north"><static>true</static><pose>2.6 4.65 0.65 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.36 3.9 1.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.36 3.9 1.3</size></box></geometry><material><ambient>0.30 0.32 0.31 1</ambient><diffuse>0.38 0.40 0.39 1</diffuse></material></visual></link></model>

    <!-- Second obstacle decision beyond the gate, with passable space on both sides. -->
    <model name="rock_cluster_a"><static>true</static><pose>4.35 1.85 0.42 0 0 0</pose><link name="link"><collision name="collision"><geometry><sphere><radius>0.48</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.48</radius></sphere></geometry><material><ambient>0.31 0.32 0.29 1</ambient><diffuse>0.39 0.40 0.36 1</diffuse></material></visual></link></model>
    <model name="rock_cluster_b"><static>true</static><pose>4.8 2.8 0.32 0 0 0</pose><link name="link"><collision name="collision"><geometry><sphere><radius>0.36</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.36</radius></sphere></geometry><material><ambient>0.27 0.28 0.26 1</ambient><diffuse>0.34 0.35 0.32 1</diffuse></material></visual></link></model>
    <model name="rock_cluster_c"><static>true</static><pose>4.9 0.9 0.28 0 0 0</pose><link name="link"><collision name="collision"><geometry><sphere><radius>0.34</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.34</radius></sphere></geometry><material><ambient>0.34 0.34 0.31 1</ambient><diffuse>0.42 0.42 0.38 1</diffuse></material></visual></link></model>

    <!-- A second narrow passage and a broad clearing create alternative routes/frontiers. -->
    <model name="passage_south"><static>true</static><pose>0.4 -4.0 0.42 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.8 0.45 0.84</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.8 0.45 0.84</size></box></geometry><material><ambient>0.33 0.29 0.21 1</ambient><diffuse>0.41 0.36 0.27 1</diffuse></material></visual></link></model>
    <model name="passage_north"><static>true</static><pose>0.4 -2.1 0.42 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.8 0.45 0.84</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.8 0.45 0.84</size></box></geometry><material><ambient>0.33 0.29 0.21 1</ambient><diffuse>0.41 0.36 0.27 1</diffuse></material></visual></link></model>
    <model name="clearing_log"><static>true</static><pose>0.3 -4.8 0.18 1.5708 0 0.25</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.18</radius><length>1.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.18</radius><length>1.8</length></cylinder></geometry><material><ambient>0.28 0.14 0.06 1</ambient><diffuse>0.38 0.20 0.08 1</diffuse></material></visual></link></model>
  </world>
</sdf>
