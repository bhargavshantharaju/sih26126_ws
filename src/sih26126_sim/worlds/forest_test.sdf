<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sih26126_forest_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.48 0.52 0.44 1</ambient>
      <background>0.72 0.82 0.91 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.27 0.38 0.19 1</ambient>
            <diffuse>0.34 0.46 0.23 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.88 0.84 0.73 1</diffuse>
      <specular>0.22 0.22 0.20 1</specular>
      <direction>-0.45 0.32 -1</direction>
    </light>

    <!-- Keep the tested robot, camera, depth sensor, IMU and odometry unchanged. -->
    <include>
      <uri>models/sih_ugv/sih_ugv.sdf</uri>
      <name>sih_ugv</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

