<?xml version="1.0"?>
<sdf version="1.9">

  <model name="sih_ugv">

    <!-- Vehicle -->
    <pose>0 0 0 0 0 0</pose>

    <!-- =========================================
         MAIN CHASSIS
         ========================================= -->
    <link name="base_link">

      <pose>0 0 0.42 0 0 0</pose>

      <inertial>
        <mass>28.0</mass>
        <inertia>
          <ixx>2.4</ixx>
          <iyy>3.2</iyy>
          <izz>4.2</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>1.20 0.78 0.30</size>
          </box>
        </geometry>
      </collision>

      <!-- RUGGED REINFORCED CHASSIS -->
      <visual name="chassis_main">
        <geometry>
          <box>
            <size>1.20 0.78 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.22 0.24 0.26 1</ambient>
          <diffuse>0.32 0.35 0.38 1</diffuse>
          <specular>0.38 0.38 0.38 1</specular>
        </material>
      </visual>

      <!-- Reinforced corner guards -->
      <visual name="corner_guard_fl">
        <pose>0.58 0.37 0.02 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.26</size></box></geometry>
        <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="corner_guard_fr">
        <pose>0.58 -0.37 0.02 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.26</size></box></geometry>
        <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="corner_guard_rl">
        <pose>-0.58 0.37 0.02 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.26</size></box></geometry>
        <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="corner_guard_rr">
        <pose>-0.58 -0.37 0.02 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.26</size></box></geometry>
        <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>

      <!-- Heavy-duty front bumper -->
      <visual name="front_bumper_main">
        <pose>0.65 0 0.00 0 0 0</pose>
        <geometry><box><size>0.14 0.90 0.18</size></box></geometry>
        <material>
          <ambient>0.15 0.17 0.18 1</ambient>
          <diffuse>0.22 0.24 0.26 1</diffuse>
        </material>
      </visual>

      <!-- Rear bumper with storage -->
      <visual name="rear_bumper_main">
        <pose>-0.65 0 0.00 0 0 0</pose>
        <geometry><box><size>0.14 0.90 0.18</size></box></geometry>
        <material>
          <ambient>0.15 0.17 0.18 1</ambient>
          <diffuse>0.22 0.24 0.26 1</diffuse>
        </material>
      </visual>

      <!-- Upper equipment deck with reinforced panels -->
      <visual name="upper_deck_main">
        <pose>0 0 0.21 0 0 0</pose>
        <geometry><box><size>0.88 0.68 0.12</size></box></geometry>
        <material>
          <ambient>0.12 0.13 0.14 1</ambient>
          <diffuse>0.18 0.20 0.22 1</diffuse>
        </material>
      </visual>

      <!-- Rear equipment/battery bay -->
      <visual name="equipment_bay">
        <pose>-0.30 0 0.28 0 0 0</pose>
        <geometry><box><size>0.52 0.52 0.08</size></box></geometry>
        <material>
          <ambient>0.08 0.12 0.16 1</ambient>
          <diffuse>0.14 0.22 0.30 1</diffuse>
        </material>
      </visual>

      <!-- Robust sensor mast -->
      <visual name="sensor_mast_lower">
        <pose>0.32 0 0.44 0 0 0</pose>
        <geometry><cylinder><radius>0.042</radius><length>0.50</length></cylinder></geometry>
        <material>
          <ambient>0.25 0.27 0.28 1</ambient>
          <diffuse>0.36 0.38 0.40 1</diffuse>
        </material>
      </visual>

      <!-- Sensor platform (elevated) -->
      <visual name="sensor_platform_base">
        <pose>0.32 0 0.72 0 0 0</pose>
        <geometry><box><size>0.48 0.32 0.10</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.24 1</ambient>
          <diffuse>0.30 0.32 0.35 1</diffuse>
        </material>
      </visual>

      <!-- RGB camera housing (front, clearly visible) -->
      <visual name="rgb_camera_housing">
        <pose>0.52 -0.08 0.70 0 0 0</pose>
        <geometry><box><size>0.08 0.12 0.08</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.10 1</ambient>
          <diffuse>0.12 0.12 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Depth camera housing (front, adjacent) -->
      <visual name="depth_camera_housing">
        <pose>0.52 0.08 0.70 0 0 0</pose>
        <geometry><box><size>0.08 0.12 0.08</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.10 1</ambient>
          <diffuse>0.12 0.12 0.15 1</diffuse>
        </material>
      </visual>

      <!-- IMU indicator (top center of platform) -->
      <visual name="imu_indicator">
        <pose>0.32 0 0.78 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.60 0.15 0.08 1</ambient>
          <diffuse>0.85 0.22 0.12 1</diffuse>
        </material>
      </visual>

      <!-- 2D LiDAR housing (center of sensor platform) -->
      <visual name="lidar_housing">
        <pose>0.32 0 0.76 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.12 0.14 1</ambient>
          <diffuse>0.15 0.18 0.22 1</diffuse>
          <specular>0.20 0.22 0.25 1</specular>
        </material>
      </visual>

      <!-- LiDAR lens/aperture ring -->
      <visual name="lidar_aperture">
        <pose>0.32 0 0.75 0 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.08 1</ambient>
          <diffuse>0.08 0.08 0.12 1</diffuse>
          <specular>0.30 0.30 0.35 1</specular>
        </material>
      </visual>

      <!-- Protective sensor roof/payload enclosure -->
      <visual name="sensor_roof_armor">
        <pose>0.32 0 0.96 0 0 0</pose>
        <geometry><box><size>0.48 0.38 0.05</size></box></geometry>
        <material>
          <ambient>0.68 0.32 0.06 1</ambient>
          <diffuse>0.88 0.44 0.08 1</diffuse>
          <specular>0.28 0.24 0.18 1</specular>
        </material>
      </visual>

      <!-- Sensor guard rails (left/right) -->
      <visual name="sensor_guard_left">
        <pose>0.32 0.17 0.85 0 0 0</pose>
        <geometry><box><size>0.44 0.04 0.22</size></box></geometry>
        <material><diffuse>0.78 0.36 0.07 1</diffuse></material>
      </visual>
      <visual name="sensor_guard_right">
        <pose>0.32 -0.17 0.85 0 0 0</pose>
        <geometry><box><size>0.44 0.04 0.22</size></box></geometry>
        <material><diffuse>0.78 0.36 0.07 1</diffuse></material>
      </visual>

      <!-- Front sensor guard bar -->
      <visual name="sensor_guard_front">
        <pose>0.52 0 0.85 0 0 0</pose>
        <geometry><box><size>0.04 0.32 0.22</size></box></geometry>
        <material><diffuse>0.78 0.36 0.07 1</diffuse></material>
      </visual>

      <!-- Rugged suspension arms with reinforced mounting -->
      <visual name="suspension_fl">
        <pose>0.42 0.43 -0.12 0 0.10 0</pose>
        <geometry><box><size>0.28 0.09 0.08</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.24 1</ambient>
          <diffuse>0.30 0.32 0.34 1</diffuse>
        </material>
      </visual>

      <visual name="suspension_rl">
        <pose>-0.42 0.43 -0.12 0 -0.10 0</pose>
        <geometry><box><size>0.28 0.09 0.08</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.24 1</ambient>
          <diffuse>0.30 0.32 0.34 1</diffuse>
        </material>
      </visual>

      <visual name="suspension_fr">
        <pose>0.42 -0.43 -0.12 0 -0.10 0</pose>
        <geometry><box><size>0.28 0.09 0.08</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.24 1</ambient>
          <diffuse>0.30 0.32 0.34 1</diffuse>
        </material>
      </visual>

      <visual name="suspension_rr">
        <pose>-0.42 -0.43 -0.12 0 0.10 0</pose>
        <geometry><box><size>0.28 0.09 0.08</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.24 1</ambient>
          <diffuse>0.30 0.32 0.34 1</diffuse>
        </material>
      </visual>

      <!-- Underbody skid plate -->
      <visual name="skid_plate">
        <pose>0 0 -0.22 0 0 0</pose>
        <geometry><box><size>0.96 0.64 0.04</size></box></geometry>
        <material>
          <ambient>0.16 0.18 0.19 1</ambient>
          <diffuse>0.24 0.26 0.28 1</diffuse>
        </material>
      </visual>

      <!-- =========================================
           IMU
           ========================================= -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.20 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>imu</topic>
      </sensor>

      <!-- =========================================
           RGB CAMERA
           ========================================= -->
      <sensor name="front_camera" type="camera">
        <pose>0.30 0 0.70 0 0 0</pose>

        <camera>
          <horizontal_fov>1.0472</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.10</near>
            <far>50.0</far>
          </clip>
        </camera>

        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>camera</topic>
      </sensor>

      <!-- =========================================
           RGB-D DEPTH CAMERA
           Organized XYZ point cloud for metric
           RGB-D visual odometry.
           ========================================= -->
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.30 0 0.70 0 0 0</pose>

        <camera>
          <horizontal_fov>1.0472</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>

          <clip>
            <near>0.10</near>
            <far>50.0</far>
          </clip>

          <depth_camera>
            <output>points</output>
          </depth_camera>
        </camera>

        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>depth_camera</topic>
      </sensor>

      <!-- Collision telemetry used by the bounded autonomy benchmark. -->
      <sensor name="chassis_contact" type="contact">
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>ugv_contacts</topic>
        <contact>
          <collision>chassis_collision</collision>
        </contact>
      </sensor>

      <!-- =========================================
           3D LiDAR (16-layer multi-beam)
           Mounted on sensor platform for SLAM/localization and
           3D terrain-aware navigation.
           Realistic specifications for outdoor navigation:
           - 270° horizontal field of view
           - 30° vertical field of view (-15° to +15°)
           - 20m range
           - 10Hz update rate
           - 720 horizontal samples × 16 vertical layers
           ========================================= -->
      <sensor name="lidar_3d" type="gpu_lidar">
        <update_rate>10</update_rate>
        <topic>lidar/points</topic>
        <gz_frame_id>sih_ugv/base_link/lidar_3d</gz_frame_id>
        <always_on>true</always_on>
        <visualize>false</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.2</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>

        <pose>0.32 0 0.75 0 0 0</pose>
      </sensor>


    </link>


    <!-- =========================================
         WHEELS
         Wheel center positions are explicit.
         Cylinder axis is rotated to Y.
         ========================================= -->

    <link name="left_front_wheel">
      <pose>0.42 0.48 0.28 0 0 0</pose>

      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.035</ixx>
          <iyy>0.035</iyy>
          <izz>0.060</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="tire">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- All-terrain tire -->
      <visual name="tire_visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.030 0.030 0.030 1</ambient>
          <diffuse>0.045 0.045 0.045 1</diffuse>
        </material>
      </visual>

      <!-- Heavy-duty hub -->
      <visual name="hub">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.20</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.38 0.40 0.42 1</ambient>
          <diffuse>0.50 0.52 0.54 1</diffuse>
        </material>
      </visual>

      <!-- Wheel center cap -->
      <visual name="wheel_cap">
        <pose>0 0.095 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.27 0.28 1</ambient>
          <diffuse>0.36 0.38 0.40 1</diffuse>
        </material>
      </visual>
    </link>


